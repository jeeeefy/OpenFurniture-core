# Normalise line endings to LF in the repository; check out as LF everywhere.
* text=auto eol=lf

# Binary files: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Files that are compared or generated textually.
package-lock.json text eol=lf
*.golden.json text eol=lf
